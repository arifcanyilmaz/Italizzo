# Bu dosyayi ".env" olarak kopyalayip kendi degerlerinizle doldurun.
# (.env dosyasi git'e gonderilmez — .gitignore icinde.)

# ---- MongoDB (zorunlu) ----
# MongoDB Atlas: Database > Connect > Drivers yolundan alacaginiz adres.
MONGODB_URI="mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="italizzo"

# ---- Giris bilgileri (login) ----
# Tanimlanmazsa varsayilan admin / admin kullanilir.
APP_USERNAME="admin"
APP_PASSWORD="admin"
